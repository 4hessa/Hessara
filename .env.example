# Vercel deployment branch. Copy to .env.local for local development.
# Configure production values in Vercel's environment settings, never in Git.
DATABASE_URL=
# Optional: full public PEM CA certificate from Supabase Database Settings > SSL Configuration.
# Multiline values or literal \n escapes are supported. Never a private key.
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only sb_secret key; required for Vercel auth IP forwarding. Never use NEXT_PUBLIC.
SUPABASE_AUTH_SECRET_KEY=
# Set true only after enabling Supabase Auth Rate Limits > IP Address Forwarding.
# Vercel authentication stays unavailable until both settings are configured.
HESSARA_AUTH_IP_FORWARDING=false
HESSARA_SITE_URL=
# Enable the matching option in Supabase Authentication before setting true.
# Requires production SMTP and allowed callback URLs in Supabase.
HESSARA_EMAIL_AUTH_ENABLED=false
# Existing email/password sign-in has a separate explicit gate (does not enable public signup).
HESSARA_PASSWORD_AUTH_ENABLED=false
# Enable only after confirming manual identity linking in Supabase for guest conversion.
HESSARA_AUTH_MANUAL_LINKING=false
# Optional: allow only this Supabase user ID to use server-owned provider keys.
HESSARA_SHARED_MODEL_OWNER_ID=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_INPUT_USD_PER_MILLION=
ANTHROPIC_OUTPUT_USD_PER_MILLION=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=

# Generate 32 cryptographically random bytes, base64 encoded. Keep stable after saving API keys.
HESSARA_ENCRYPTION_KEY=

# Optional Paperclip integration; only this exact Hessara user may send drafts.
PAPERCLIP_BASE_URL=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_API_KEY=
PAPERCLIP_OWNER_ID=

# Reverse Engineering: private storage uses the existing server-only Supabase key.
# Effective upload limit is also bounded by the private bucket and DB policy.
HESSARA_RE_MAX_UPLOAD_BYTES=52428800
# Create only when deploying a dedicated, benchmarked Linux worker. At least 32 random characters.
# Keep this token in the trusted supervisor; never pass it to engine containers.
HESSARA_RE_WORKER_TOKEN=
# Protects daily lease recovery and bounded retention maintenance.
CRON_SECRET=
