    "@babel/core@^7": "7.29.7",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "description": "A multilingual, Arabic-first model evaluation workspace"
