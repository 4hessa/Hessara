{
  "name": "hessara",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --webpack --port 5173",
    "build": "next build --webpack",
    "build:local": "node scripts/build-local.mjs",
    "start": "next start --port 5173",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "test:low-memory": "node --liftoff-only --wasm-num-compilation-tasks=1 --disable-wasm-trap-handler --max-old-space-size=320 --max-semi-space-size=2 --v8-pool-size=1 --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:embedded": "node scripts/audit-embedded-dependencies.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
